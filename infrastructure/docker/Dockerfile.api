FROM python:3.12-slim-bookworm

# Install runtime dependencies including ffmpeg, curl, and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    git \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22.x (required by bgutil-ytdlp-pot-provider script mode, minimum v22)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Clone and build bgutil-ytdlp-pot-provider server (for script-mode PO token generation)
RUN git clone --depth 1 https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /opt/bgutil-pot \
    && cd /opt/bgutil-pot/server \
    && npm install \
    && npx tsc \
    && chmod -R 755 /opt/bgutil-pot

WORKDIR /app

# Copy dependency specifications
COPY back-end/requirements.txt ./requirements.txt

# Install python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend codebase
COPY back-end /app

# Create ephemeral download directory
RUN mkdir -p /tmp/media-downloader && chmod 777 /tmp/media-downloader

# Copy container startup script
COPY infrastructure/docker/start-api.sh /usr/local/bin/start-api.sh
RUN sed -i 's/\r$//' /usr/local/bin/start-api.sh && chmod +x /usr/local/bin/start-api.sh

EXPOSE 8000

CMD ["/usr/local/bin/start-api.sh"]
