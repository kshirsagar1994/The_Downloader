# ==========================================
# Universal Media Downloader - Environment Config
# ==========================================

# Application Environment (development / staging / production)
APP_ENV=development
DEBUG=true

# API Server Config
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379/0

# Media Binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# Storage & Ephemeral Lifecycle
DOWNLOAD_DIR=./tmp/media-downloader
DOWNLOAD_EXPIRY_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=60

# YouTube PO Token Provider, Authentication & Proxies (Optional)
# Dynamic BgUtils PO Token Provider HTTP URL (defaults to http://127.0.0.1:4416 in Docker container)
PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416
POT_PROVIDER_PORT=4416
# Direct PO Token & Visitor Data (e.g., web.player+<token>)
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
# Optional authentication cookies (Netscape format string OR base64-encoded)
YOUTUBE_COOKIES=
# Optional path to cookies file on disk
YOUTUBE_COOKIES_FILE=
COOKIES_FILE=
# Optional residential or egress proxy for datacenter bypass (e.g., http://user:pass@proxy.example.com:8080)
YOUTUBE_PROXY_URL=
YOUTUBE_PROXY=
# yt-dlp release channel (stable / nightly)
YT_DLP_UPDATE_CHANNEL=stable
# Comma-separated player clients (prioritizes visionos/android on cloud hosts with tv/mweb/web PO token support)
YOUTUBE_CLIENTS=visionos,android,tv,mweb,ios,web
# Path to bgutil-ytdlp-pot-provider server directory for local script-mode PO token generation
# Auto-detected at /opt/bgutil-pot/server (Docker) or ~/bgutil-ytdlp-pot-provider/server
BGUTIL_SCRIPT_HOME=

# Rate Limiting & Abuse Protection
RATE_LIMIT_EXTRACT_PER_MIN=20
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_DOWNLOAD_PER_MIN=30
MAX_FILE_SIZE_MB=5000
MAX_PLAYLIST_ITEMS=50
MAX_CONCURRENT_JOBS_PER_IP=3
MAX_JOB_DURATION_SECONDS=900
MAX_EXTRACTION_TIMEOUT_SECONDS=20

# Admin Portal Security
ADMIN_SECRET_KEY=change-this-to-a-secure-random-token-in-production
